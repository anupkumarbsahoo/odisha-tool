{
  "_readme": "All site selectors and fixed values live here (taken from recording/recording.txt). Selectors are Playwright selector strings (#id, css=, text=, role=...).",

  "login_url": "https://nirmanshramik.odisha.gov.in/obocwwb/public/cwLogin",
  "browser_profile_dir": "profile/firefox",
  "headless": false,
  "slow_mo_ms": 150,
  "default_timeout_ms": 30000,
  "dropdown_load_timeout_ms": 20000,
  "settle_timeout_ms": 10000,
  "field_timeout_ms": 5000,
  "village_match_threshold": 80,
  "date_format": "%Y-%m-%d",
  "extractor": "extractors.gemini",
  "gemini_models": ["gemini-flash-latest", "gemini-3.5-flash", "gemini-flash-lite-latest", "gemini-2.5-flash"],

  "selectors": {
    "login_pay_annual_contribution": "role=link[name=/Pay Annual Contribution/i]",
    "registration_number_input": "#reNo",
    "proceed_button": "role=button[name=/Proceed/i]",
    "pay_annual_contribution_button": "role=button[name=/Pay Annual Contribution/i]",
    "document_upload_input": "#workingCertificate",
    "upload_documents_button": "role=button[name=/Upload Documents/i]",
    "add_details_button": "#EstablishmentAdd"
  },

  "_details_form_readme": "Establishment details, filled top to bottom in this order (same order as the recording). 'field' = text input filled from the session only when empty (prefilled values are compared, mismatches shown in a popup). 'select' = fixed dropdown value. 'select_if_empty' = fixed value only when nothing is chosen yet (otherwise compared).'fuzzy_select' = dropdown picked by fuzzy match against a session field (or the first non-empty of a list of fields; 'fallback' when all are empty; 'replace': true re-selects when the site shows a different value). transform: 'date' (reformat to date_format), 'digits', or 'address' (hyphens to spaces, for the site's letters/digits/space/dot/comma check). Read-only site fields (worker name, father's name) are only compared.",
  "details_form": [
    {"field": "name", "selector": "#workerFullName"},
    {"field": "guardian_name", "selector": "#fathersName"},
    {"fuzzy_select": "block", "fallback": "KENDUJHAR", "replace": true, "selector": "#block", "label": "Present Block"},
    {"field": "employer_name", "selector": "#estName"},
    {"field": "employer_name", "selector": "#estContactPerson", "label": "Contact Person"},
    {"field": "employer_contact", "selector": "#estContactNO", "transform": "digits"},
    {"field": "employer_address", "selector": "#estAdd", "transform": "address"},
    {"select": "Unskilled Construction Worker", "selector": "#estNatureOfJob", "label": "Nature of Work"},
    {"select": "Private", "selector": "#govtOrPrivate", "label": "Govt/Private"},
    {"select": "ODISHA", "selector": "#stateIdEst", "label": "State"},
    {"fuzzy_select": "district", "fallback": "KENDUJHAR", "replace": true, "selector": "#districtEst", "label": "District"},
    {"fuzzy_select": "block", "fallback": "KENDUJHAR", "replace": true, "selector": "#blockEst", "label": "Block"},
    {"fuzzy_select": "village", "selector": "#villageEstDiv", "label": "Village"},
    {"field": "gp_municipality", "selector": "#estGram"},
    {"field": "pin", "selector": "#estPin", "transform": "digits"},
    {"select": "Self certification", "selector": "#employmentCertifiedBy", "label": "Employment certified by"},
    {"field": "employment_from", "selector": "#estFrom", "transform": "date"},
    {"field": "employment_to", "selector": "#estTo", "transform": "date"}
  ],

  "registration": {
    "_readme": "One Time Registration. 'otr' and 'login' use real ids from the public page. 'form' runs top to bottom: {'section': heading} sets where labels are searched from; 'fill'/'select'/'ask_fill' name a session field (or '=VALUE' for a fixed value) and find the control by 'label' (text the label starts with) or 'sel' (explicit selector). Text fields are filled only when empty; filled ones are compared. 'fuzzy': true picks the closest option. 'optional': true skips a control that is not shown. 'or_fill': selector of a text box to type into when the dropdown is not shown. Ids were read from the real page (logs/error_*.html). 'skip_on_refill': true on a section makes 'Fill remaining fields' skip it (Aadhaar needs an OTP, done once). 'once': true marks a button (Add Member / Add Details / Add Establishment / Upload) that 'Fill remaining fields' must not press again. 'skip_section_if_shown': label skips the rest of the section when that field is already on the page (e.g. Aadhaar already verified). When a dropdown cannot be matched, the tool asks you to pick it in Firefox.",
    "max_upload_kb": 490,
    "otr": {
      "open_link": "text=One Time Registration",
      "declaration": "#declarationCheck1",
      "terms_proceed": "input[onclick='openOneTimeReg()']",
      "first_name": "#onetimeName",
      "surname": "#name",
      "gender": "#applicantGender",
      "mobile": "#mobileNumber",
      "registered_no": "#alreadyRegistredN",
      "proceed": "input[onclick='saveOTR()']",
      "otp": "xpath=//div[contains(@class,'modal') and contains(@class,'show')]//label[contains(normalize-space(.),'OTP')]/ancestor::div[1]//input",
      "submit": "css=.modal.show >> role=button[name=/^submit$/i]",
      "username_text": "css=.modal.show >> text=/Username\\s*:/i",
      "username_regex": "Username\\s*:\\s*([A-Za-z0-9]+)",
      "close": "css=.modal.show >> role=button[name=/close|×/i]"
    },
    "login": {
      "username": "#username",
      "request_otp": "#requestOtp",
      "otp": "#password",
      "captcha_image": "#captchaIdentifier",
      "captcha_input": "input[name=captcha]",
      "captcha_refresh": "css=.fa-refresh, .fa-sync, [onclick*=aptcha]",
      "sign_in": "role=button[name=/sign in/i]",
      "logged_in_marker": "text=Aadhaar Details"
    },
    "defaults": {
      "addr_state": "ODISHA",
      "marital_status": "Married",
      "nature_of_work": "Unskilled Construction Worker",
      "education": "Below 7th class",
      "category": "",
      "religion": "Hindu",
      "physically_challenged": "No",
      "nom_share": "100",
      "employment_certified_by": "Self certification",
      "establishment_type": "Private"
    },
    "form": [
      {"section": "Aadhaar Details", "skip_on_refill": true},
      {"skip_section_if_shown": "Name as per Aadhaar"},
      {"fill": "app_aadhaar", "label": "Aadhaar Number", "sel": "#applicantAadhaar", "transform": "digits"},
      {"check": "#declarationCheck5"},
      {"click": "#verifyAadhaar", "optional": true},
      {"otp": true, "label": "Enter OTP", "sel": "#aadhaarOtp", "prompt": "Enter the OTP sent to the Aadhaar-linked mobile."},
      {"click": "#verifyAadhaarOtp", "settle_ms": 15000},

      {"section": "General Details"},
      {"fill": "app_dob", "label": "Date of Birth", "sel": "#applicantDob", "transform": "date"},
      {"ask_fill": "app_father_name", "label": "Father's Name", "sel": "#applicantFather", "prompt": "The father's name is not on the Aadhaar card. Type the applicant's father's name:"},
      {"select": "marital_status", "label": "Marital Status", "sel": "#maritalStatu"},
      {"fill": "spouse_name", "label": "Spouse's Name", "sel": "#spouseNames", "optional": true},
      {"select": "nature_of_work", "label": "Nature of Work", "sel": "#natureOfJob"},
      {"select": "education", "label": "Education Qualification", "sel": "#eduOrTraining"},

      {"section": "Permanent Address"},
      {"fill": "addr_line", "label": "Address", "sel": "#permanentAdd", "transform": "address"},
      {"select": "addr_state", "label": "State", "sel": "#stateId"},
      {"select": "addr_district", "label": "District", "sel": "#District", "fuzzy": true},
      {"select": "addr_block", "label": "Block", "sel": "#permanentBlock", "fuzzy": true},
      {"select": "addr_gp", "label": "Gram Panchayat", "sel": "#permanentGram", "fuzzy": true},
      {"select": "addr_village", "label": "Village", "sel": "#perVillage", "fuzzy": true},
      {"fill": "addr_pin", "label": "Pincode", "sel": "#permanentPostOffice", "transform": "digits"},
      {"check": "#sameAdd"},

      {"section": "Present Address"},
      {"fill": "addr_line", "label": "Present Address", "sel": "#presentAdd", "transform": "address"},
      {"select": "addr_district", "label": "Present District", "sel": "#presentDistrict", "fuzzy": true},
      {"select": "addr_block", "label": "Present Block", "sel": "#block", "fuzzy": true},
      {"select": "addr_gp", "label": "Present Gram Panchayat", "sel": "#presentGramPanchayat", "fuzzy": true},
      {"select": "addr_village", "label": "Present Village", "sel": "#preVillage", "fuzzy": true},
      {"fill": "addr_pin", "label": "Present Pincode", "sel": "#presentPincode", "transform": "digits"},

      {"section": "Family Details"},
      {"select": "nom_relationship", "label": "Family Relationship", "sel": "#famMemRelationship"},
      {"fill": "nom_name", "label": "Family Member Name", "sel": "#famMemName"},
      {"fill": "nom_aadhaar", "label": "Family Member Aadhaar", "sel": "#famMemAadhaar", "transform": "digits"},
      {"fill": "nom_dob", "label": "Family Member Date of Birth", "sel": "#famMemAge", "transform": "date"},
      {"check": "#declarationCheck7"},
      {"click": "#saveMemberForm", "once": true},

      {"section": "Nominee details"},
      {"select": "nom_name", "label": "Nominee Name", "sel": "#nomineeName", "fuzzy": true},
      {"fill": "nom_address", "label": "Nominee Address", "sel": "#nomineeAddress", "transform": "address"},
      {"select": "nom_relationship", "label": "Nominee Relationship", "sel": "#nomineeRelation"},
      {"fill": "nom_share", "label": "Share in percentage", "sel": "#nomineeShare", "transform": "digits"},
      {"select": "nom_bank_name", "label": "Nominee Bank name", "sel": "#bankNameId", "fuzzy": true},
      {"fill": "nom_bank_branch", "label": "Nominee Branch", "sel": "#nomBranchName"},
      {"fill": "nom_bank_ifsc", "label": "Nominee IFSC", "sel": "#nomIfscCode"},
      {"fill": "nom_bank_account", "label": "Nominee Account Number", "sel": "#nomAccNo", "transform": "digits"},
      {"fill": "nom_bank_account", "label": "Nominee Confirm Account Number", "sel": "#nomConAccNO", "transform": "digits"},
      {"click": "#saveNomineeForm", "once": true},

      {"section": "Details of the establishment"},
      {"fill": "employer_name", "label": "Name of Establishment", "sel": "#estName"},
      {"fill": "employer_contact", "label": "Employer Contact number", "sel": "#estContactNO", "transform": "digits"},
      {"select": "establishment_type", "label": "Govt/Private", "sel": "#govtOrPrivate"},
      {"select": "nature_of_work", "label": "Establishment Nature of Work", "sel": "#estNatureOfJob"},
      {"fill": "employer_address", "label": "Establishment's address", "sel": "#estAdd", "transform": "address"},
      {"select": "=ODISHA", "label": "Establishment State", "sel": "#stateIdEst"},
      {"select": "est_district", "label": "Establishment District", "sel": "#districtEst", "fuzzy": true},
      {"select": "est_block", "label": "Establishment Block", "sel": "#blockEst", "fuzzy": true},
      {"select": "est_gp", "label": "Establishment Gram Panchayat", "sel": "#estGramSelect", "or_fill": "#estGramText", "fuzzy": true},
      {"select": "est_village", "label": "Establishment Village", "sel": "#villageEstDiv", "fuzzy": true},
      {"fill": "est_pin", "label": "Establishment Pincode", "sel": "#estPin", "transform": "digits"},
      {"select": "employment_certified_by", "label": "Employment certified by", "sel": "#employmentCertifiedBy"},
      {"fill": "employment_from", "label": "Period from", "sel": "#estFrom", "transform": "date"},
      {"fill": "employment_to", "label": "Period upto", "sel": "#estTo", "transform": "date"},
      {"click": "#saveEstablishmentForm", "once": true},

      {"section": "Other Details"},
      {"select": "category", "label": "Category", "sel": "#caste"},
      {"select": "religion", "label": "Religion", "sel": "#minority"},
      {"select": "physically_challenged", "label": "Physically Challenged", "sel": "#disability"},

      {"section": "Bank Details"},
      {"fill": "app_bank_holder", "label": "Account holder Name", "sel": "#accountHolderName"},
      {"select": "app_bank_name", "label": "Bank name", "sel": "#bankNameB", "fuzzy": true},
      {"fill": "app_bank_branch", "label": "Name of Branch", "sel": "#branchNameB"},
      {"fill": "app_bank_ifsc", "label": "IFSC", "sel": "#ifscCodeB"},
      {"fill": "app_bank_account", "label": "Account Number", "sel": "#accNoB", "transform": "digits"},
      {"fill": "app_bank_account", "label": "Confirm Account Number", "sel": "#conAccNOB", "transform": "digits"},

      {"confirm": true},
      {"section": "Supporting Documents"},
      {"upload": ["app_bank", "app_photo", "app_aadhaar", "signature", "job_card"], "sel": ["#passbook", "#passportSizePhoto", "#aadhaar", "#signature", "#workingCertificate"]},
      {"click": "[onclick='saveAttachments()']", "settle_ms": 15000, "once": true}
    ]
  },
  "employment": {
    "_readme": "Employment Registration on the State Employment Service portal. The tool recognises the open page by 'page_markers' (checked in order), fills it with the steps in 'pages' and presses Next. Steps find a control by 'label' (text the label starts with; 'after' = search from this heading; 'nth' = n-th control after the label) or by 'sel'. 'fill' / 'select' / 'date' (day, month, year boxes) name a session field, '=VALUE' for a fixed value, 'q.x' for the qualification being added. Text boxes are filled only when empty. 'replace': true re-selects a dropdown that shows a default; 'fuzzy': true picks the closest option ('scorer': 'partial' to match part of the name). 'when': only run when that field has a value. 'optional': skip a control that is not shown. When something cannot be filled, the tool asks you to do it in Firefox and continues.",
    "entry_url": "https://empmission.odisha.gov.in/Exchange/Entry.jsp",
    "registration_link": "JobSeeker Registration",
    "max_photo_kb": 19,
    "max_pdf_kb": 98,
    "reg_no_label": "Registration No",
    "reg_no_regex": "\\b(OD\\d{10,})\\b",
    "page_markers": {
      "willingness": "Willingness Details",
      "additional": "Additional Information Details",
      "languages": "Languages Details",
      "experience": "If not applicable proceed to the next step",
      "qualification": "Educational Qualification(Enter 10th onwards)",
      "personal": "JobSeeker Registration : Personal Details",
      "exchange": "Select Exchange",
      "declaration": "Instruction For Registration"
    },
    "page_titles": {"exchange": "Select Exchange", "personal": "Personal Details", "qualification": "Educational Qualification", "experience": "Experience", "languages": "Languages", "additional": "Additional Information", "willingness": "Willingness"},
    "buttons": {
      "accept": "input[value='Accept']",
      "submit": "input[name='next'][value='Submit']",
      "next": "input[value='Next'], button:has-text('Next'), input[name='next']",
      "qualification_submit": "input[name='next'], input[value='Next']",
      "add_qualification": "input[value*='Add Qualification'], button:has-text('Add Qualification')"
    },
    "captcha": {"image": "img[src*='aptcha']", "input": "input[name='captcha']", "input_after_image": "xpath=//img[contains(@src, 'aptcha')]/following::input[not(@type) or @type='text']"},
